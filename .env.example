# Βάση δεδομένων. Το Docker Compose σηκώνει αυτόματα την Postgres.
POSTGRES_DB=tenders
POSTGRES_USER=tenders
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://tenders:change-me@postgres:5432/tenders
APP_ENV=development

# Host port for the web app. Use 80 on a VM where users should open http://server/.
WEB_PORT=8000

# Προαιρετικό εταιρικό proxy. Αφήστε τα κενά αν το PC/server έχει απευθείας internet.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,postgres

# ΚΗΜΔΗΣ Open Data API
KHMDHS_BASE_URL=https://cerpp.eprocurement.gov.gr
KHMDHS_TIMEOUT_SECONDS=90
# Η χειροκίνητη αναζήτηση αποτυγχάνει γρήγορα αντί να κρατά τη σελίδα σε αναμονή.
KHMDHS_INTERACTIVE_TIMEOUT_SECONDS=15
KHMDHS_INTERACTIVE_TRANSPORT_RETRIES=1
KHMDHS_MAX_PAGES=20
# Proactive pacing με προσαρμοστικό slowdown όταν το API επιστρέψει 429.
KHMDHS_RATE_LIMIT_RETRIES=4
KHMDHS_RATE_LIMIT_BASE_DELAY_SECONDS=5.0
# Προσωρινά read/connect errors επαναλαμβάνονται πριν αναλάβει το self-continuation.
KHMDHS_TRANSPORT_RETRIES=3
KHMDHS_TRANSPORT_BASE_DELAY_SECONDS=2.0
KHMDHS_REQUESTS_PER_MINUTE=180
# Maximum CPV codes sent in one KIMDIS query. Each batch has its own checkpoint.
KHMDHS_CPV_BATCH_SIZE=100
KHMDHS_QUERY_CACHE_HOURS=20
KHMDHS_SYNC_OVERLAP_DAYS=1
KHMDHS_CONTINUATION_DELAY_SECONDS=15
KHMDHS_CONTINUATION_MAX_ATTEMPTS=50
# Longer pause after each group of rapid self-continuations; the chain is not abandoned.
KHMDHS_CONTINUATION_COOLDOWN_SECONDS=900
DIAVGEIA_BASE_URL=https://diavgeia.gov.gr/luminapi/opendata
DIAVGEIA_TIMEOUT_SECONDS=30
DIAVGEIA_DEFAULT_PAGE_SIZE=10

# Scheduler: καθημερινή εισαγωγή.
SCHEDULE_HOUR=7
SCHEDULE_MINUTE=15
# Local-only rescore: no API calls. Keeps deadline-based scores current.
SCORE_REFRESH_MINUTES=15
INGEST_DAYS_BACK=3
MATCH_THRESHOLD=55
# Legacy flags. Το τωρινό ingest είναι metadata-first και δεν κατεβάζει PDFs μαζικά.
FETCH_PDF_FOR_SCORE_ABOVE=40
AUTO_FETCH_PDF_TEXT=false
PDF_MAX_BYTES=60000000
# OCR εκτελείται μόνο όταν το PDF δεν έχει επαρκές ενσωματωμένο κείμενο.
PDF_OCR_ENABLED=true
PDF_OCR_MAX_PAGES=10
PDF_OCR_DPI=200
PDF_OCR_LANGUAGES=ell+eng
PDF_OCR_PAGE_TIMEOUT_SECONDS=30

# Πρώτη αυτόματη αναζήτηση ΚΗΜΔΗΣ μετά τη δημιουργία ενεργού προφίλ.
INITIAL_PROFILE_INGEST_DAYS=30

# Ζώνη ώρας εμφάνισης στο UI και στις αναφορές. Για Ελλάδα αφήστε Europe/Athens.
APP_TIMEZONE=Europe/Athens

# Προαιρετικό basic auth για web interface. Βάλτε τιμές πριν το δώσετε σε πελάτη.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# User-oriented login. SESSION_SECRET_KEY signs browser sessions.
# On first startup with an empty user table, BOOTSTRAP_ADMIN_* creates the first admin.
SESSION_SECRET_KEY=
SESSION_MAX_AGE_SECONDS=86400
SESSION_COOKIE_SECURE=false
REQUIRE_SESSION_SECRET=false
CSRF_PROTECTION_ENABLED=true
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
ALLOW_LOCAL_ADMIN_FALLBACK=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
MIN_PASSWORD_LENGTH=12

# Προαιρετικό email digest.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
DIGEST_RECIPIENTS=
